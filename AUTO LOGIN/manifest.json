{
  "manifest_version": 3,
  "name": "ChatGPT Auto Login",
  "version": "2.0.0",
  "description": "Tự động đăng nhập ChatGPT: Email → Password → OTP/2FA. Hỗ trợ Google Authenticator.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://auth.openai.com/*",
    "https://auth0.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://auth.openai.com/*",
        "https://auth0.openai.com/*"
      ],
      "js": ["totp.js", "content.js", "mfa_flow.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["totp.js", "mfa_flow.js"],
      "matches": [
        "https://chatgpt.com/*",
        "https://auth.openai.com/*",
        "https://auth0.openai.com/*"
      ]
    }
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
